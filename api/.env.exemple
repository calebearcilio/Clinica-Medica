# ==========================================
# Variáveis de Ambiente - Backend
# ==========================================
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores reais
# Este arquivo é apenas um exemplo e será ignorado

# ==========================================
# Conexão com banco de dados
# PostgreSQL || Docker || Render || Supabase
# Formato: postgresql://usuario:senha@host:porta/banco
# OBRIGAÓTIO
# ==========================================
DATABASE_URL=

# ==========================================
# Conexão com banco de dados Supabase
# OBRIGAÓTIO se for usar Supabase
# ==========================================
DIRECT_URL=


# ==========================================
# Porta do servidor Express
# OPCIONAL
# ==========================================
PORT=3333

# ==========================================
# Ambiente
# Valores: development, production, test
# OPCIONAL
# ==========================================
NODE_ENV="development"

# ==========================================
# Chave de Segurança JWT
# OBRIGATÓRIO - use uma string longa e aleatória (mínimo 32 caracteres)
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
JWT_KEY=SUA_CHAVE_SECRETA_ALEATORIA_AQUI

# ==========================================
# Origem permitida pelo CORS (URL do frontend)
# OPCIONAL - padrão: http://localhost:5173
# ==========================================
CORS_ORIGIN="http://localhost:5173"
